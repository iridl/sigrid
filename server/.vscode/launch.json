{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
			{
				"name": "current file",
				"type": "debugpy",
				"request": "launch",
				"console": "integratedTerminal",
				"program": "${file}",
				"args": [
				],
				"envFile": "${workspaceFolder}/../.env"
			},
			{
				"name": "pydap server",
				"type": "debugpy",
				"request": "launch",
				"console": "integratedTerminal",
				"program": "${workspaceFolder}/test/server.py",
				"args": [
				],
				"cwd": "${workspaceFolder}",
				"envFile": "${workspaceFolder}/../.env"
			},
			{
				"name": "client-test",
				"type": "debugpy",
				"request": "launch",
				"module": "pytest",
				"python": "${workspaceFolder}/.pixi/envs/client/bin/python",
				"args": [
					"client-test",
					"${input:extraArgs}"
				],
				"console": "integratedTerminal",
				"cwd": "${workspaceFolder}",
				"envFile": "${workspaceFolder}/../.env"
			}
    ],
	"inputs": [
		{
			"id": "extraArgs",
			"type": "promptString",
			"description": "extra pytest args"
		}
	]
}